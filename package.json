{
  "name": "@lofcz/tikz",
  "version": "0.2.0",
  "description": "Self-contained, process-isolated TikZ to SVG rendering powered by mp-tikz-wasm.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./deploy": {
      "types": "./src/deploy.d.ts",
      "default": "./src/deploy.js"
    },
    "./package.json": "./package.json",
    "./browser": {
      "types": "./src/browser.d.ts",
      "default": "./src/browser.js"
    }
  },
  "files": [
    "src",
    "runtime",
    "LICENSE",
    "NOTICE.md",
    "upstream.json"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/tikz.git"
  },
  "homepage": "https://github.com/lofcz/tikz#readme",
  "bugs": {
    "url": "https://github.com/lofcz/tikz/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/prepare-runtime.mjs",
    "test": "node --test test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm run build && npm test && npm run test:package",
    "prepack": "npm run build",
    "build:engine": "tsc -p packages/engine/tsconfig.build.json",
    "test:browser": "node test/browser.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "tar": "^7.5.22",
    "typescript": "^5.9.3"
  }
}
